USE [TERA];
GO

IF OBJECT_ID(N'[B_lawson].[trg_HR_Snapshot_StaticMask_INS]', 'TR') IS NOT NULL
    DROP TRIGGER [B_lawson].[trg_HR_Snapshot_StaticMask_INS];
GO

CREATE TRIGGER [B_lawson].[trg_HR_Snapshot_StaticMask_INS]
ON [B_lawson].[HR_Snapshot]
INSTEAD OF INSERT
AS
BEGIN
    SET NOCOUNT ON;

    ;WITH src AS (
        SELECT
            i.*,
            Seed =
                COALESCE(
                    NULLIF(LTRIM(RTRIM(
                        COALESCE(CONVERT(varchar(200), i.EMPLOYEE), '') + '|' +
                        COALESCE(i.FIRST_NAME, '') + '|' +
                        COALESCE(i.LAST_NAME, '') + '|' +
                        COALESCE(i.EMAIL_ADDRESS, '') + '|' +
                        COALESCE(CONVERT(varchar(10), i.BIRTHDATE, 120), '')
                    )), ''),
                    CONVERT(varchar(36), NEWID())
                )
        FROM inserted i
    )
    INSERT INTO [B_lawson].[HR_Snapshot] (
        [DATA_MONTH],
        [COMPANY],
        [MARKET],
        [MKT_ID_2],
        [PROCESS_LEVEL],
        [LOCAT_CODE],
        [FACILITY_NAME],
        [EMPLOYEE],
        [FIRST_NAME],
        [MIDDLE_INIT],
        [MIDDLE_NAME],
        [LAST_NAME],
        [EMP_STATUS],
        [EMP_STATUS_DESC],
        [CODE_DESC],
        [REASON_CODE],
        [REASON_EFF_DT],
        [EXEMPT_EMP],
        [AGE],
        [SEX],
        [EEO_CLASS],
        [DEPARTMENT],
        [DEPARTMENT_NAME],
        [JOB_CLASS],
        [JOB_CLASS_DESC],
        [JOB_CODE],
        [JOB_CODE_DESC],
        [POSITION],
        [POSITION_DESC],
        [USER_LEVEL],
        [SUPERVISOR_IND],
        [SUPERVISORS_EMP_NUM],
        [SUPERVISOR],
        [SUPERVISORS_CODE],
        [SUPERVISORS_DESC],
        [SCHEDULE],
        [SCHEDULE_DESC],
        [HM_ACCOUNT],
        [HM_ACCT_UNIT],
        [HM_DIST_CO],
        [BIRTHDATE],
        [ANNIVERS_DATE],
        [NEW_HIRE_DATE],
        [DATE_HIRED],
        [ADJ_HIRE_DATE],
        [FST_DAY_WORKED],
        [TERM_DATE],
        [DEATH_DATE],
        [LAST_DAY_PAID],
        [CREATION_DATE],
        [CREATE_DATE],
        [FTE],
        [NBR_FTE],
        [FTE_Raw],
        [FTE_Total],
        [PREV_EMP_STATUS],
        [COUNT],
        [EMAIL_ADDRESS],
        [SourceId],
        [Created_Date],
        [Created_By]
    )
    SELECT
        -- Pass-through
        i.[DATA_MONTH],
        i.[COMPANY],
        i.[MARKET],
        i.[MKT_ID_2],
        i.[PROCESS_LEVEL],
        i.[LOCAT_CODE],
        i.[FACILITY_NAME],

        -- Masked
        CASE 
            WHEN i.EMPLOYEE IS NULL OR NULLIF(LTRIM(RTRIM(CONVERT(varchar(200), i.EMPLOYEE))), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(CONVERT(varchar(200), i.EMPLOYEE)))) IN ('NONE','NULL','N/A','NA')
            THEN i.EMPLOYEE
            ELSE 'EMP' + RIGHT('00000000' + CAST(ABS(CAST(CHECKSUM(i.Seed + '_EMP') AS BIGINT)) % 100000000 AS varchar(8)), 8)
        END,

        CASE
            WHEN i.FIRST_NAME IS NULL OR NULLIF(LTRIM(RTRIM(i.FIRST_NAME)), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(i.FIRST_NAME))) IN ('NONE','NULL','N/A','NA')
            THEN i.FIRST_NAME
            ELSE CASE ABS(CAST(CHECKSUM(i.Seed + '_FN') AS BIGINT)) % 10
                WHEN 0 THEN 'James' WHEN 1 THEN 'Mary' WHEN 2 THEN 'John' WHEN 3 THEN 'Patricia' WHEN 4 THEN 'Robert'
                WHEN 5 THEN 'Linda' WHEN 6 THEN 'Michael' WHEN 7 THEN 'Barbara' WHEN 8 THEN 'David' WHEN 9 THEN 'Elizabeth'
            END
        END,

        CASE
            WHEN i.MIDDLE_INIT IS NULL OR NULLIF(LTRIM(RTRIM(i.MIDDLE_INIT)), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(i.MIDDLE_INIT))) IN ('NONE','NULL','N/A','NA')
            THEN i.MIDDLE_INIT
            ELSE CHAR(65 + (ABS(CAST(CHECKSUM(i.Seed + '_MI') AS BIGINT)) % 26))
        END,

        CASE
            WHEN i.MIDDLE_NAME IS NULL OR NULLIF(LTRIM(RTRIM(i.MIDDLE_NAME)), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(i.MIDDLE_NAME))) IN ('NONE','NULL','N/A','NA')
            THEN i.MIDDLE_NAME
            ELSE CASE ABS(CAST(CHECKSUM(i.Seed + '_MN') AS BIGINT)) % 10
                WHEN 0 THEN 'Allen' WHEN 1 THEN 'Marie' WHEN 2 THEN 'Lee' WHEN 3 THEN 'Grace' WHEN 4 THEN 'Ray'
                WHEN 5 THEN 'Ann' WHEN 6 THEN 'Scott' WHEN 7 THEN 'Jean' WHEN 8 THEN 'Paul' WHEN 9 THEN 'Lynn'
            END
        END,

        CASE
            WHEN i.LAST_NAME IS NULL OR NULLIF(LTRIM(RTRIM(i.LAST_NAME)), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(i.LAST_NAME))) IN ('NONE','NULL','N/A','NA')
            THEN i.LAST_NAME
            ELSE CASE ABS(CAST(CHECKSUM(i.Seed + '_LN') AS BIGINT)) % 10
                WHEN 0 THEN 'Smith' WHEN 1 THEN 'Johnson' WHEN 2 THEN 'Williams' WHEN 3 THEN 'Brown' WHEN 4 THEN 'Jones'
                WHEN 5 THEN 'Garcia' WHEN 6 THEN 'Miller' WHEN 7 THEN 'Davis' WHEN 8 THEN 'Rodriguez' WHEN 9 THEN 'Martinez'
            END
        END,

        -- Pass-through
        i.[EMP_STATUS],
        i.[EMP_STATUS_DESC],
        i.[CODE_DESC],
        i.[REASON_CODE],
        i.[REASON_EFF_DT],
        i.[EXEMPT_EMP],

        CASE
            WHEN i.BIRTHDATE IS NULL THEN i.AGE
            WHEN i.AGE IS NULL THEN NULL
            ELSE
                DATEDIFF(YEAR, bd.MaskedBirthdate, CAST(GETDATE() AS date))
                - CASE
                    WHEN DATEADD(YEAR, DATEDIFF(YEAR, bd.MaskedBirthdate, CAST(GETDATE() AS date)), bd.MaskedBirthdate) > CAST(GETDATE() AS date)
                    THEN 1 ELSE 0
                  END
        END,

        CASE
            WHEN i.SEX IS NULL OR NULLIF(LTRIM(RTRIM(i.SEX)), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(i.SEX))) IN ('NONE','NULL','N/A','NA')
            THEN i.SEX
            ELSE CASE ABS(CAST(CHECKSUM(i.Seed + '_SEX') AS BIGINT)) % 3
                WHEN 0 THEN 'M' WHEN 1 THEN 'F' WHEN 2 THEN 'U'
            END
        END,

        -- Pass-through
        i.[EEO_CLASS],
        i.[DEPARTMENT],
        i.[DEPARTMENT_NAME],
        i.[JOB_CLASS],
        i.[JOB_CLASS_DESC],
        i.[JOB_CODE],
        i.[JOB_CODE_DESC],
        i.[POSITION],
        i.[POSITION_DESC],
        i.[USER_LEVEL],
        i.[SUPERVISOR_IND],

        CASE
            WHEN i.SUPERVISORS_EMP_NUM IS NULL OR NULLIF(LTRIM(RTRIM(CONVERT(varchar(200), i.SUPERVISORS_EMP_NUM))), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(CONVERT(varchar(200), i.SUPERVISORS_EMP_NUM)))) IN ('NONE','NULL','N/A','NA')
            THEN i.SUPERVISORS_EMP_NUM
            ELSE 'SUP' + RIGHT('00000000' + CAST(ABS(CAST(CHECKSUM(i.Seed + '_SUPNUM') AS BIGINT)) % 100000000 AS varchar(8)), 8)
        END,

        CASE
            WHEN i.SUPERVISOR IS NULL OR NULLIF(LTRIM(RTRIM(i.SUPERVISOR)), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(i.SUPERVISOR))) IN ('NONE','NULL','N/A','NA')
            THEN i.SUPERVISOR
            ELSE CASE ABS(CAST(CHECKSUM(i.Seed + '_SUP') AS BIGINT)) % 10
                WHEN 0 THEN 'Anderson' WHEN 1 THEN 'Thomas' WHEN 2 THEN 'Jackson' WHEN 3 THEN 'White' WHEN 4 THEN 'Harris'
                WHEN 5 THEN 'Martin' WHEN 6 THEN 'Thompson' WHEN 7 THEN 'Moore' WHEN 8 THEN 'Taylor' WHEN 9 THEN 'Clark'
            END
        END,

        -- Pass-through
        i.[SUPERVISORS_CODE],
        i.[SUPERVISORS_DESC],
        i.[SCHEDULE],
        i.[SCHEDULE_DESC],
        i.[HM_ACCOUNT],
        i.[HM_ACCT_UNIT],
        i.[HM_DIST_CO],

        CASE
            WHEN i.BIRTHDATE IS NULL THEN NULL
            ELSE bd.MaskedBirthdate
        END,

        CASE WHEN i.ANNIVERS_DATE IS NULL THEN NULL
             ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(i.Seed + '_ANN') AS BIGINT)) % 12000, CONVERT(date,'2000-01-01'))
        END,

        CASE WHEN i.NEW_HIRE_DATE IS NULL THEN NULL
             ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(i.Seed + '_NHD') AS BIGINT)) % 12000, CONVERT(date,'2000-01-01'))
        END,

        CASE WHEN i.DATE_HIRED IS NULL THEN NULL
             ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(i.Seed + '_DHD') AS BIGINT)) % 12000, CONVERT(date,'2000-01-01'))
        END,

        CASE WHEN i.ADJ_HIRE_DATE IS NULL THEN NULL
             ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(i.Seed + '_AHD') AS BIGINT)) % 12000, CONVERT(date,'2000-01-01'))
        END,

        CASE WHEN i.FST_DAY_WORKED IS NULL THEN NULL
             ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(i.Seed + '_FDW') AS BIGINT)) % 12000, CONVERT(date,'2000-01-01'))
        END,

        CASE WHEN i.TERM_DATE IS NULL THEN NULL
             ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(i.Seed + '_TRM') AS BIGINT)) % 12000, CONVERT(date,'2000-01-01'))
        END,

        CASE WHEN i.DEATH_DATE IS NULL THEN NULL
             ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(i.Seed + '_DTH') AS BIGINT)) % 12000, CONVERT(date,'2010-01-01'))
        END,

        CASE WHEN i.LAST_DAY_PAID IS NULL THEN NULL
             ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(i.Seed + '_LDP') AS BIGINT)) % 12000, CONVERT(date,'2000-01-01'))
        END,

        -- Pass-through
        i.[CREATION_DATE],
        i.[CREATE_DATE],
        i.[FTE],
        i.[NBR_FTE],
        i.[FTE_Raw],
        i.[FTE_Total],
        i.[PREV_EMP_STATUS],
        i.[COUNT],

        CASE
            WHEN i.EMAIL_ADDRESS IS NULL OR NULLIF(LTRIM(RTRIM(i.EMAIL_ADDRESS)), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(i.EMAIL_ADDRESS))) IN ('NONE','NULL','N/A','NA')
            THEN i.EMAIL_ADDRESS
            ELSE 'user' + RIGHT(CONVERT(varchar(40), ABS(CAST(CHECKSUM(i.Seed + '_EM') AS BIGINT))), 12) + '@example.com'
        END,

        -- Pass-through
        i.[SourceId],
        i.[Created_Date],

        CASE
            WHEN i.Created_By IS NULL OR NULLIF(LTRIM(RTRIM(CONVERT(varchar(200), i.Created_By))), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(CONVERT(varchar(200), i.Created_By)))) IN ('NONE','NULL','N/A','NA')
            THEN i.Created_By
            ELSE 'system_' + RIGHT(CONVERT(varchar(20), ABS(CAST(CHECKSUM(i.Seed + '_CBY') AS BIGINT))), 6)
        END
    FROM src i
    CROSS APPLY (
        SELECT MaskedBirthdate =
            CASE
                WHEN i.BIRTHDATE IS NULL THEN NULL
                ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(i.Seed + '_DOB') AS BIGINT)) % 25550, CONVERT(date,'1940-01-01'))
            END
    ) bd;
END;
GO

