USE [TERA];
GO
SET NOCOUNT ON;

UPDATE h
SET
    EMPLOYEE =
        CASE 
            WHEN h.EMPLOYEE IS NULL OR NULLIF(LTRIM(RTRIM(CONVERT(varchar(200), h.EMPLOYEE))), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(CONVERT(varchar(200), h.EMPLOYEE)))) IN ('NONE','NULL','N/A','NA')
            THEN h.EMPLOYEE
            ELSE 'EMP' + RIGHT('00000000' + CAST(ABS(CAST(CHECKSUM(s.Seed + '_EMP') AS BIGINT)) % 100000000 AS varchar(8)), 8)
        END,

    FIRST_NAME =
        CASE
            WHEN h.FIRST_NAME IS NULL OR NULLIF(LTRIM(RTRIM(h.FIRST_NAME)), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(h.FIRST_NAME))) IN ('NONE','NULL','N/A','NA')
            THEN h.FIRST_NAME
            ELSE CASE ABS(CAST(CHECKSUM(s.Seed + '_FN') AS BIGINT)) % 10
                WHEN 0 THEN 'James' WHEN 1 THEN 'Mary' WHEN 2 THEN 'John' WHEN 3 THEN 'Patricia' WHEN 4 THEN 'Robert'
                WHEN 5 THEN 'Linda' WHEN 6 THEN 'Michael' WHEN 7 THEN 'Barbara' WHEN 8 THEN 'David' WHEN 9 THEN 'Elizabeth'
            END
        END,

    MIDDLE_INIT =
        CASE
            WHEN h.MIDDLE_INIT IS NULL OR NULLIF(LTRIM(RTRIM(h.MIDDLE_INIT)), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(h.MIDDLE_INIT))) IN ('NONE','NULL','N/A','NA')
            THEN h.MIDDLE_INIT
            ELSE CHAR(65 + (ABS(CAST(CHECKSUM(s.Seed + '_MI') AS BIGINT)) % 26))
        END,

    MIDDLE_NAME =
        CASE
            WHEN h.MIDDLE_NAME IS NULL OR NULLIF(LTRIM(RTRIM(h.MIDDLE_NAME)), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(h.MIDDLE_NAME))) IN ('NONE','NULL','N/A','NA')
            THEN h.MIDDLE_NAME
            ELSE CASE ABS(CAST(CHECKSUM(s.Seed + '_MN') AS BIGINT)) % 10
                WHEN 0 THEN 'Allen' WHEN 1 THEN 'Marie' WHEN 2 THEN 'Lee' WHEN 3 THEN 'Grace' WHEN 4 THEN 'Ray'
                WHEN 5 THEN 'Ann' WHEN 6 THEN 'Scott' WHEN 7 THEN 'Jean' WHEN 8 THEN 'Paul' WHEN 9 THEN 'Lynn'
            END
        END,

    LAST_NAME =
        CASE
            WHEN h.LAST_NAME IS NULL OR NULLIF(LTRIM(RTRIM(h.LAST_NAME)), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(h.LAST_NAME))) IN ('NONE','NULL','N/A','NA')
            THEN h.LAST_NAME
            ELSE CASE ABS(CAST(CHECKSUM(s.Seed + '_LN') AS BIGINT)) % 10
                WHEN 0 THEN 'Smith' WHEN 1 THEN 'Johnson' WHEN 2 THEN 'Williams' WHEN 3 THEN 'Brown' WHEN 4 THEN 'Jones'
                WHEN 5 THEN 'Garcia' WHEN 6 THEN 'Miller' WHEN 7 THEN 'Davis' WHEN 8 THEN 'Rodriguez' WHEN 9 THEN 'Martinez'
            END
        END,

    SUPERVISORS_EMP_NUM =
        CASE
            WHEN h.SUPERVISORS_EMP_NUM IS NULL OR NULLIF(LTRIM(RTRIM(CONVERT(varchar(200), h.SUPERVISORS_EMP_NUM))), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(CONVERT(varchar(200), h.SUPERVISORS_EMP_NUM)))) IN ('NONE','NULL','N/A','NA')
            THEN h.SUPERVISORS_EMP_NUM
            ELSE 'SUP' + RIGHT('00000000' + CAST(ABS(CAST(CHECKSUM(s.Seed + '_SUPNUM') AS BIGINT)) % 100000000 AS varchar(8)), 8)
        END,

    SUPERVISOR =
        CASE
            WHEN h.SUPERVISOR IS NULL OR NULLIF(LTRIM(RTRIM(h.SUPERVISOR)), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(h.SUPERVISOR))) IN ('NONE','NULL','N/A','NA')
            THEN h.SUPERVISOR
            ELSE CASE ABS(CAST(CHECKSUM(s.Seed + '_SUP') AS BIGINT)) % 10
                WHEN 0 THEN 'Anderson' WHEN 1 THEN 'Thomas' WHEN 2 THEN 'Jackson' WHEN 3 THEN 'White' WHEN 4 THEN 'Harris'
                WHEN 5 THEN 'Martin' WHEN 6 THEN 'Thompson' WHEN 7 THEN 'Moore' WHEN 8 THEN 'Taylor' WHEN 9 THEN 'Clark'
            END
        END,

    BIRTHDATE =
        CASE
            WHEN h.BIRTHDATE IS NULL THEN NULL
            ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(s.Seed + '_DOB') AS BIGINT)) % 25550, CONVERT(date,'1940-01-01'))
        END,

    AGE =
        CASE
            WHEN h.BIRTHDATE IS NULL THEN h.AGE
            WHEN h.AGE IS NULL THEN NULL
            ELSE
                DATEDIFF(YEAR, bd.MaskedBirthdate, CAST(GETDATE() AS date))
                - CASE
                    WHEN DATEADD(YEAR, DATEDIFF(YEAR, bd.MaskedBirthdate, CAST(GETDATE() AS date)), bd.MaskedBirthdate) > CAST(GETDATE() AS date)
                    THEN 1 ELSE 0
                  END
        END,

    SEX =
        CASE
            WHEN h.SEX IS NULL OR NULLIF(LTRIM(RTRIM(h.SEX)), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(h.SEX))) IN ('NONE','NULL','N/A','NA')
            THEN h.SEX
            ELSE CASE ABS(CAST(CHECKSUM(s.Seed + '_SEX') AS BIGINT)) % 3
                WHEN 0 THEN 'M' WHEN 1 THEN 'F' WHEN 2 THEN 'U'
            END
        END,

    DEATH_DATE =
        CASE
            WHEN h.DEATH_DATE IS NULL THEN NULL
            ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(s.Seed + '_DTH') AS BIGINT)) % 12000, CONVERT(date,'2010-01-01'))
        END,

    EMAIL_ADDRESS =
        CASE
            WHEN h.EMAIL_ADDRESS IS NULL OR NULLIF(LTRIM(RTRIM(h.EMAIL_ADDRESS)), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(h.EMAIL_ADDRESS))) IN ('NONE','NULL','N/A','NA')
            THEN h.EMAIL_ADDRESS
            ELSE 'user' + RIGHT(CONVERT(varchar(40), ABS(CAST(CHECKSUM(s.Seed + '_EM') AS BIGINT))), 12) + '@example.com'
        END,

    ANNIVERS_DATE =
        CASE WHEN h.ANNIVERS_DATE IS NULL THEN NULL
             ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(s.Seed + '_ANN') AS BIGINT)) % 12000, CONVERT(date,'2000-01-01'))
        END,

    NEW_HIRE_DATE =
        CASE WHEN h.NEW_HIRE_DATE IS NULL THEN NULL
             ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(s.Seed + '_NHD') AS BIGINT)) % 12000, CONVERT(date,'2000-01-01'))
        END,

    DATE_HIRED =
        CASE WHEN h.DATE_HIRED IS NULL THEN NULL
             ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(s.Seed + '_DHD') AS BIGINT)) % 12000, CONVERT(date,'2000-01-01'))
        END,

    ADJ_HIRE_DATE =
        CASE WHEN h.ADJ_HIRE_DATE IS NULL THEN NULL
             ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(s.Seed + '_AHD') AS BIGINT)) % 12000, CONVERT(date,'2000-01-01'))
        END,

    FST_DAY_WORKED =
        CASE WHEN h.FST_DAY_WORKED IS NULL THEN NULL
             ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(s.Seed + '_FDW') AS BIGINT)) % 12000, CONVERT(date,'2000-01-01'))
        END,

    TERM_DATE =
        CASE WHEN h.TERM_DATE IS NULL THEN NULL
             ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(s.Seed + '_TRM') AS BIGINT)) % 12000, CONVERT(date,'2000-01-01'))
        END,

    LAST_DAY_PAID =
        CASE WHEN h.LAST_DAY_PAID IS NULL THEN NULL
             ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(s.Seed + '_LDP') AS BIGINT)) % 12000, CONVERT(date,'2000-01-01'))
        END,

    Created_By =
        CASE
            WHEN h.Created_By IS NULL OR NULLIF(LTRIM(RTRIM(CONVERT(varchar(200), h.Created_By))), '') IS NULL
                 OR UPPER(LTRIM(RTRIM(CONVERT(varchar(200), h.Created_By)))) IN ('NONE','NULL','N/A','NA')
            THEN h.Created_By
            ELSE 'system_' + RIGHT(CONVERT(varchar(20), ABS(CAST(CHECKSUM(s.Seed + '_CBY') AS BIGINT))), 6)
        END
FROM [S_people].[HR_Snapshots] h
CROSS APPLY (
    SELECT Seed =
        COALESCE(
            NULLIF(LTRIM(RTRIM(
                COALESCE(CONVERT(varchar(200), h.EMPLOYEE), '') + '|' +
                COALESCE(h.FIRST_NAME, '') + '|' +
                COALESCE(h.LAST_NAME, '') + '|' +
                COALESCE(h.EMAIL_ADDRESS, '') + '|' +
                COALESCE(CONVERT(varchar(10), h.BIRTHDATE, 120), '')
            )), ''),
            CONVERT(varchar(36), NEWID())
        )
) s
CROSS APPLY (
    SELECT MaskedBirthdate =
        CASE
            WHEN h.BIRTHDATE IS NULL THEN NULL
            ELSE DATEADD(DAY, ABS(CAST(CHECKSUM(s.Seed + '_DOB') AS BIGINT)) % 25550, CONVERT(date,'1940-01-01'))
        END
) bd;
GO


