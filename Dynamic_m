SELECT
    c.name AS ColumnName,
    c.is_masked,
    mc.masking_function
FROM sys.columns c
LEFT JOIN sys.masked_columns mc
    ON c.object_id = mc.object_id
   AND c.column_id = mc.column_id
WHERE c.object_id = OBJECT_ID(N'[B_lawson].[HR_Snapshot]')
ORDER BY c.column_id;
