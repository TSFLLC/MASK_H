
UPDATE t
SET
    EMPLOYEE = 'EMP' + RIGHT('00000000' + CAST(ABS(CHECKSUM(EMPLOYEE, EMAIL_ADDRESS, FIRST_NAME, LAST_NAME)) % 100000000 AS varchar(8)), 8),
    FIRST_NAME =
        CASE ABS(CHECKSUM(EMPLOYEE, 'FN')) % 10
            WHEN 0 THEN 'James' WHEN 1 THEN 'Mary' WHEN 2 THEN 'John' WHEN 3 THEN 'Patricia' WHEN 4 THEN 'Robert'
            WHEN 5 THEN 'Linda' WHEN 6 THEN 'Michael' WHEN 7 THEN 'Barbara' WHEN 8 THEN 'David' WHEN 9 THEN 'Elizabeth'
        END,
    MIDDLE_INIT = CHAR(65 + ABS(CHECKSUM(EMPLOYEE, 'MI')) % 26),
    MIDDLE_NAME =
        CASE ABS(CHECKSUM(EMPLOYEE, 'MN')) % 6
            WHEN 0 THEN 'Lee' WHEN 1 THEN 'Grace' WHEN 2 THEN 'Ann'
            WHEN 3 THEN 'Jean' WHEN 4 THEN 'Ray' WHEN 5 THEN 'Marie'
        END,
    LAST_NAME =
        CASE ABS(CHECKSUM(EMPLOYEE, 'LN')) % 10
            WHEN 0 THEN 'Smith' WHEN 1 THEN 'Johnson' WHEN 2 THEN 'Williams' WHEN 3 THEN 'Brown' WHEN 4 THEN 'Jones'
            WHEN 5 THEN 'Garcia' WHEN 6 THEN 'Miller' WHEN 7 THEN 'Davis' WHEN 8 THEN 'Rodriguez' WHEN 9 THEN 'Martinez'
        END,
    EMAIL_ADDRESS = 'user' + RIGHT(CAST(ABS(CHECKSUM(EMPLOYEE, EMAIL_ADDRESS)) AS varchar(20)), 8) + '@example.com',
    BIRTHDATE = CASE WHEN BIRTHDATE IS NOT NULL
                     THEN DATEADD(DAY, ABS(CHECKSUM(EMPLOYEE, 'BD')) % 3650, '1970-01-01')
                     ELSE NULL END,
    AGE = CASE
            WHEN AGE IS NULL THEN NULL
            WHEN AGE < 25 THEN 20
            WHEN AGE BETWEEN 25 AND 34 THEN 30
            WHEN AGE BETWEEN 35 AND 44 THEN 40
            WHEN AGE BETWEEN 45 AND 54 THEN 50
            WHEN AGE BETWEEN 55 AND 64 THEN 60
            ELSE 65
          END,
    SEX = CASE WHEN SEX IS NULL THEN NULL ELSE 'U' END,
    DEATH_DATE = NULL,
    SUPERVISORS_EMP_NUM = CASE WHEN SUPERVISORS_EMP_NUM IS NULL THEN NULL
                               ELSE 'SUP' + RIGHT('00000000' + CAST(ABS(CHECKSUM(SUPERVISORS_EMP_NUM, SUPERVISOR)) % 100000000 AS varchar(8)), 8) END,
    SUPERVISOR =
        CASE WHEN SUPERVISOR IS NULL THEN NULL
             ELSE 'Manager' + RIGHT(CAST(ABS(CHECKSUM(SUPERVISOR, EMPLOYEE)) AS varchar(20)), 5)
        END,
    USER_LEVEL = CASE WHEN USER_LEVEL IS NULL THEN NULL ELSE 'MASKED' END
FROM [TERA].[S_people].[UT_North_Snapshots] t;
