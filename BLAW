      [JOB_CODE_DESC],[POSITION],[POSITION_DESC],[USER_LEVEL],[SUPERVISOR_IND],[SUPERVISORS_EMP_NUM],[SUPERVISOR],
      [SUPERVISORS_CODE],[SUPERVISORS_DESC],[SCHEDULE_DESC],[HM_ACCOUNT],[HM_ACCT_UNIT],[HM_DIST_CO],[BIRTHDATE],
      [ANNIVERS_DATE],[NEW_HIRE_DATE],[DATE_HIRED],[ADJ_HIRE_DATE],[FST_DAY_WORKED],[TERM_DATE],[DEATH_DATE],
      [LAST_DAY_PAID],[CREATION_DATE],[CREATE_DATE],[FTE],[NBR_FTE],[FTE_RAW],[FTE_TOTAL],[PREV_EMP_STATUS],
      [DATA_MONTH],[EMAIL_ADDRESS],[SourceId],[Created_By],[Created_Date],[Record_Checksum]
    )
    SELECT
      i.[JOB_CODE],i.[JOB_CLASS],i.[SCHEDULE],i.[PROCESS_LEVEL],i.[DEPARTMENT],i.[COMPANY],i.[MARKET],i.[MKT_ID_2],i.[LOCAT_CODE],
      i.[FACILITY_NAME],
      'EMP' + RIGHT('00000000' + CAST(ABS(CHECKSUM(i.[EMPLOYEE], i.[EMAIL_ADDRESS], i.[FIRST_NAME], i.[LAST_NAME])) % 100000000 AS varchar(8)), 8),
      CASE ABS(CHECKSUM(i.[EMPLOYEE], 'FN')) % 10
            WHEN 0 THEN 'James' WHEN 1 THEN 'Mary' WHEN 2 THEN 'John' WHEN 3 THEN 'Patricia' WHEN 4 THEN 'Robert'
            WHEN 5 THEN 'Linda' WHEN 6 THEN 'Michael' WHEN 7 THEN 'Barbara' WHEN 8 THEN 'David' WHEN 9 THEN 'Elizabeth'
      END,
      CHAR(65 + ABS(CHECKSUM(i.[EMPLOYEE], 'MI')) % 26),
      CASE ABS(CHECKSUM(i.[EMPLOYEE], 'MN')) % 6
            WHEN 0 THEN 'Lee' WHEN 1 THEN 'Grace' WHEN 2 THEN 'Ann'
            WHEN 3 THEN 'Jean' WHEN 4 THEN 'Ray' WHEN 5 THEN 'Marie'
      END,
      CASE ABS(CHECKSUM(i.[EMPLOYEE], 'LN')) % 10
            WHEN 0 THEN 'Smith' WHEN 1 THEN 'Johnson' WHEN 2 THEN 'Williams' WHEN 3 THEN 'Brown' WHEN 4 THEN 'Jones'
            WHEN 5 THEN 'Garcia' WHEN 6 THEN 'Miller' WHEN 7 THEN 'Davis' WHEN 8 THEN 'Rodriguez' WHEN 9 THEN 'Martinez'
      END,
      i.[EMP_STATUS],i.[EMP_STATUS_DESC],i.[CODE_DESC],i.[REASON_CODE],i.[REASON_EFF_DT],i.[EXEMPT_EMP],
      CASE
            WHEN i.[AGE] IS NULL THEN NULL
            WHEN i.[AGE] < 25 THEN 20
            WHEN i.[AGE] BETWEEN 25 AND 34 THEN 30
            WHEN i.[AGE] BETWEEN 35 AND 44 THEN 40
            WHEN i.[AGE] BETWEEN 45 AND 54 THEN 50
            WHEN i.[AGE] BETWEEN 55 AND 64 THEN 60
            ELSE 65
      END,
      CASE WHEN i.[SEX] IS NULL THEN NULL ELSE 'U' END,
      i.[EEO_CLASS],i.[DEPARTMENT_NAME],i.[JOB_CLASS_DESC],i.[JOB_CODE_DESC],i.[POSITION],i.[POSITION_DESC],
      CASE WHEN i.[USER_LEVEL] IS NULL THEN NULL ELSE 'MASKED' END,
      i.[SUPERVISOR_IND],
      CASE WHEN i.[SUPERVISORS_EMP_NUM] IS NULL THEN NULL
           ELSE 'SUP' + RIGHT('00000000' + CAST(ABS(CHECKSUM(i.[SUPERVISORS_EMP_NUM], i.[SUPERVISOR])) % 100000000 AS varchar(8)), 8) END,
      CASE WHEN i.[SUPERVISOR] IS NULL THEN NULL
