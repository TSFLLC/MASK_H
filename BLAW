      i.[SUPERVISORS_CODE],i.[SUPERVISORS_DESC],i.[SCHEDULE_DESC],i.[HM_ACCOUNT],i.[HM_ACCT_UNIT],i.[HM_DIST_CO],
      CASE WHEN i.[BIRTHDATE] IS NOT NULL THEN DATEADD(DAY, ABS(CHECKSUM(i.[EMPLOYEE], 'BD')) % 3650, '1970-01-01') ELSE NULL END,
      i.[ANNIVERS_DATE],i.[NEW_HIRE_DATE],i.[DATE_HIRED],i.[ADJ_HIRE_DATE],i.[FST_DAY_WORKED],i.[TERM_DATE],
      NULL,
      i.[LAST_DAY_PAID],i.[CREATION_DATE],i.[CREATE_DATE],i.[FTE],i.[NBR_FTE],i.[FTE_RAW],i.[FTE_TOTAL],i.[PREV_EMP_STATUS],
      i.[DATA_MONTH],
      'user' + RIGHT(CAST(ABS(CHECKSUM(i.[EMPLOYEE], i.[EMAIL_ADDRESS])) AS varchar(20)), 8) + '@example.com',
      i.[SourceId],i.[Created_By],i.[Created_Date],i.[Record_Checksum]
